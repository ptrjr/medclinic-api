# Banco local: preencha a senha e use o mesmo valor no Docker Compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=medclinic
# true para PostgreSQL gerenciado com SSL e certificado verificado.
DB_SSL=false

PORT=3000
# Gere um segredo com pelo menos 32 caracteres. Não use os exemplos em produção.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Obrigatórias somente para o seed, inclusive no start:prod do container.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
